[Unit]
Description=Bounded health observer for the existing Mobile Proxy GitHub Actions runner
After=network-online.target mobile-proxy-phone-runner.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/mobile-proxy-runner-health/runner-transport-health.sh
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mobile-proxy-runner-health
